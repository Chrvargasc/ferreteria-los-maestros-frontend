# Guía 18: rutas relativas, porque Nginx publica React y las dos API en la misma dirección.
# /api/auth-service/  -> Auth  127.0.0.1:8081/api/   (login: /api/auth-service/v1/auth/login)
# /api/tienda-service/ -> Tienda 127.0.0.1:8080/api/  (productos: /api/tienda-service/v1/productos)
# Como no traen la IP, un cambio de IP de la EC2 no obliga a recompilar React.
VITE_AUTH_API_URL=/api/auth-service/v1
VITE_API_URL=/api/tienda-service/v1
